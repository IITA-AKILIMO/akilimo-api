APP_NAME=AKILIMO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:9100
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Password given to the admin user created by AdminUserSeeder
DEFAULT_ADMIN_PASSWORD=

# API version shown in the generated API docs
API_VERSION=1.0.0

# Lifetime of bearer tokens issued at login, in days
AUTH_TOKEN_TTL_DAYS=30

# Worker processes for `php artisan serve`
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Grafana Loki (add "loki" to LOG_STACK to enable)
# LOKI_URL=http://loki:3100
# LOKI_USER=
# LOKI_PASSWORD=
# LOKI_JOB=akilimo

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akilimo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Cache TTL for recommendation responses (e.g. 15s, 30m, 1h, 2d)
CACHE_TTL=1h

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@akilimo.org"
MAIL_FROM_NAME="${APP_NAME}"

# PDF reports. The compute service makes a PDF for every recommendation; the API keeps it and answers with a signed,
# expiring download link. A report holds the farmer's name, masked phone number and farm location: keep the storage
# private and in the backups. The lines below are commented out because they are the defaults; uncomment to change.
# Keep the reports at all? false = no PDF is requested or stored.
# AKILIMO_REPORTS_ENABLED=true
# Where they are kept. Not set = the app's default disk (FILESYSTEM_DISK), so FILESYSTEM_DISK=s3 puts them on S3 too;
# AKILIMO_REPORTS_DISK=local
# Days a download link works. The report itself does not expire; a new link can be made at any time.
# AKILIMO_REPORTS_LINK_TTL_DAYS=7
# Delete reports older than this many days (`reports:prune`, scheduled daily). 0 or empty = keep as long as the history.
# AKILIMO_REPORTS_KEEP_DAYS=0
# Largest PDF kept, in bytes; bigger ones are dropped and logged. Default 10 MB.
# AKILIMO_REPORTS_MAX_BYTES=10485760

# S3-compatible storage for the reports (e.g. Alarik): set FILESYSTEM_DISK=s3 (or AKILIMO_REPORTS_DISK=s3 for the reports alone), fill in the two keys below, then
# run `php artisan reports:check-storage` to prove it works. Keep the bucket private. Needs the S3 driver:
# composer require league/flysystem-aws-s3-v3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The next lines are commented out on purpose: an empty value here would override the defaults in
# config/filesystems.php (bucket akilimo-rec, endpoint https://s3.munywele.co.ke, region us-east-1, path-style).
# Uncomment only to change one; AWS_ENDPOINT= (empty) means AWS itself, and then also set AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=akilimo-rec
# AWS_ENDPOINT=https://s3.munywele.co.ke
# AWS_USE_PATH_STYLE_ENDPOINT=true
# Objects are written private by default; set empty only if the store rejects ACL headers
# AWS_VISIBILITY=private

# Akilimo compute service (R/Plumber recommendations API)
AKILIMO_COMPUTE_BASE_URL=http://127.0.0.1:8000
AKILIMO_COMPUTE_ENDPOINT=/compute
AKILIMO_COMPUTE_TIMEOUT=120
AKILIMO_COMPUTE_RETRIES=3
AKILIMO_COMPUTE_LOGGING=true

# Reject compute requests outside the synced coverage area (see `php artisan coverage:sync`)
COVERAGE_VALIDATE=true

# Docker image tag used by docker-compose.yml
# AKILIMO_TAG=latest

# Requests per minute and client IP (config/rate-limits.php). The defaults are for production; raise them locally,
# where the MCP agent's web UI makes many lookups before it computes. Routes that share a key share one counter.
API_RATE_AUTH_PER_MINUTE=10
API_RATE_SENSITIVE_PER_MINUTE=5
API_RATE_READ_PER_MINUTE=120
API_RATE_WRITE_PER_MINUTE=30
API_RATE_COMPUTE_PER_MINUTE=30
API_RATE_ADMIN_WRITE_PER_MINUTE=60
API_RATE_MCP_VERIFY_PER_MINUTE=600
