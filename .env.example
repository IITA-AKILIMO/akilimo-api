APP_NAME=AKILIMO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:9100
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Password given to the admin user created by AdminUserSeeder
DEFAULT_ADMIN_PASSWORD=

# API version shown in the generated API docs
API_VERSION=1.0.0

# Lifetime of bearer tokens issued at login, in days
AUTH_TOKEN_TTL_DAYS=30

# Worker processes for `php artisan serve`
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Grafana Loki (add "loki" to LOG_STACK to enable)
# LOKI_URL=http://loki:3100
# LOKI_USER=
# LOKI_PASSWORD=
# LOKI_JOB=akilimo

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akilimo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Cache TTL for recommendation responses (e.g. 15s, 30m, 1h, 2d)
CACHE_TTL=1h

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@akilimo.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Akilimo compute service (R/Plumber recommendations API)
AKILIMO_COMPUTE_BASE_URL=http://127.0.0.1:8000
AKILIMO_COMPUTE_ENDPOINT=/compute
AKILIMO_COMPUTE_TIMEOUT=120
AKILIMO_COMPUTE_RETRIES=3
AKILIMO_COMPUTE_LOGGING=true

# Reject compute requests outside the synced coverage area (see `php artisan coverage:sync`)
COVERAGE_VALIDATE=true

# Docker image tag used by docker-compose.yml
# AKILIMO_TAG=latest
