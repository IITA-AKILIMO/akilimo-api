# PHPStan configuration for this project
parameters:
    level: 5
    paths:
        - app/Http/Controllers/Web
    excludePaths:
        - app/Models/Base/*
        - app/Repositories/*
        - app/Console/*
        - app/Traits/*
        - app/Events/*
    ignoreErrors:
        - '#Dynamic call to static method Illuminate\\Http\\Request::validate\(\)#'
