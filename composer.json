{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "iita/akilimo-api",
  "type": "project",
  "description": "AKILIMO API — agricultural recommendation engine for fertilizer, intercropping, and planting schedules.",
  "keywords": [
    "akilimo",
    "agriculture",
    "recommendations",
    "laravel",
    "api"
  ],
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "masgeek/composer-scripts": true,
      "masgeek/windows-ext-ignorer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "require": {
    "php": "^8.2",
    "ext-pdo": "^8.2",
    "angel-source-labs/laravel-spatial": "^1.3.1",
    "dedoc/scramble": "^0.13.41",
    "inertiajs/inertia-laravel": "^3.3.1",
    "laracraft-tech/laravel-useful-additions": "^4.3",
    "laravel/framework": "^12.67",
    "laravel/octane": "^2.19.1",
    "laravel/sanctum": "^4.3.3",
    "laravel/tinker": "^2.11.1",
    "league/csv": "^9.28",
    "masgeek/artisan-toolkit": "dev-develop",
    "spatie/laravel-data": "^4.23",
    "spatie/laravel-schedule-monitor": "^4.3.1",
    "vermaysha/pgbouncer-laravel-extension": "^0.0.5@beta"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7",
    "fakerphp/faker": "^1.24.1",
    "kitloong/laravel-migrations-generator": "^7.4",
    "larastan/larastan": "^3.10",
    "laravel/pail": "^1.2.7",
    "laravel/pint": "^1.30.5",
    "laravel/sail": "^1.67",
    "masgeek/composer-scripts": "dev-main",
    "masgeek/reliese-laravel-model-gen": "^2.2.3",
    "masgeek/windows-ext-ignorer": "^0.1.5",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.5",
    "pestphp/pest": "4.x-dev",
    "sebastian/environment": "^8.1.2",
    "vcian/laravel-db-auditor": "^2.2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev:all": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"green,cyan\" \"php artisan serve --port=9100\" \"pnpm dev\" --names='server,vite'"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan serve --port=9100"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packagist.org"
    },
    {
      "type": "vcs",
      "url": "https://github.com/masgeek/reliese-laravel-model-gen"
    },
    {
      "type": "vcs",
      "url": "https://github.com/masgeek/composer-scripts"
    }
  ]
}
